{
  "name": "psstamigo",
  "private": true,
  "version": "0.3.0",
  "description": "A lightweight, privacy-focused, peer-to-peer voice and text communication application. No accounts, no cameras, no screen sharing, no recordings.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "PSST_E2E_TARGET=preview playwright test",
    "check": "npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
